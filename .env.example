# Choose one LLM backend.

# Azure OpenAI
AZURE_OPENAI_BASE_URL=https://your-resource.openai.azure.com/openai/deployments/your-deployment/chat/completions?api-version=2024-10-21
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_MODEL=your-deployment-name

# OpenAI-compatible endpoint (alternative)
# LLM_GPT4O_URL=https://your-gateway.example/v1/chat/completions
# LLM_API_KEY=
# LLM_GPT4O_MODEL=your-model

# GLM/Anthropic-compatible gateway (alternative)
# ANTHROPIC_BASE_URL=https://your-gateway.example/v1/chat/completions
# ANTHROPIC_AUTH_TOKEN=
# ANTHROPIC_MODEL=your-model

USE_LOCAL_STORAGE=true

# Optional GitHub settings
GITHUB_TOKEN=
GITHUB_TRENDING_SINCE=daily
GITHUB_TRENDING_LANGUAGE=
GITHUB_TRENDING_LIMIT=20
